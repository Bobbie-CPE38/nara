# PostgreSQL — local development only
POSTGRES_DB=staffing
POSTGRES_USER=staffing
POSTGRES_PASSWORD=staffing_dev
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://staffing:staffing_dev@postgres:5432/staffing
# Optional. Defaults to ["http://localhost:${FRONTEND_PORT}"], so set it only for a non-localhost setup
# CORS_ORIGINS=["http://localhost:3000"]

# Job service: calls the backend's /internal routes every JOB_INTERVAL_SECONDS.
# The secret below is a placeholder for local development. Set your own value
# (8 characters or more) anywhere else, and never commit it
INTERNAL_JOB_SECRET=local-dev-only
JOB_INTERVAL_SECONDS=30

# LINE: real mode also requires both secrets; blank secrets keep simulation.
LINE_MODE=simulation
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LLM (PR X): round 3 uses fake; real Bedrock in round 6. No AWS keys here: Bedrock uses the default AWS credential chain (IAM Role on AWS).
LLM_ENABLED=false
LLM_PROVIDER=fake
LLM_MODEL_ID=
AWS_REGION=
# LLM_PROVIDER=lambda only (round 6 PR B3): the API Gateway URL and its API key. Never commit a key
LLM_LAMBDA_URL=
LLM_LAMBDA_API_KEY=
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_INPUT_PRICE_PER_MTOK_USD=
LLM_OUTPUT_PRICE_PER_MTOK_USD=
# Round 6 quota (docs/workflow.md 6.27). Blank keeps the default: 100 attempts a day
# (Asia/Bangkok, retries included), 20 USD a month, 5,000 input tokens, 4 attempts per
# row, 180 attempts per model trial run
LLM_DAILY_CALL_CAP=
LLM_QUOTA_TIMEZONE=
LLM_MONTHLY_BUDGET_USD=
LLM_MAX_INPUT_TOKENS=
LLM_MAX_ATTEMPTS_PER_ROW=
LLM_TRIAL_CALL_CAP=

# Login (round 6 PR AU1, docs/workflow.md 6.33). Any other value stops the backend.
# demo: X-Demo-User picks who you are, no password. session: log in at /auth/login.
# Make accounts with: docker compose exec backend python -m app.auth_accounts --help
APP_ENV=dev
AUTH_MODE=demo
# false only for plain-HTTP localhost; APP_ENV=aws refuses false
AUTH_COOKIE_SECURE=false
AUTH_SESSION_MAX_AGE_SECONDS=43200
AUTH_SESSION_IDLE_SECONDS=1800

# Frontend
FRONTEND_PORT=3000
BACKEND_URL=http://backend:8000
# Optional. Defaults to http://localhost:${BACKEND_PORT}, so set it only for a non-localhost setup
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
