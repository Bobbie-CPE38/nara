{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeNovaLiteViaGlobalProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:REGION:ACCOUNT_ID:inference-profile/global.amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-2-lite-v1:0",
        "arn:aws:bedrock:::foundation-model/amazon.nova-2-lite-v1:0"
      ]
    }
  ]
}
