# Copy outside the repository to /etc/nara/nara.env, owned by root, mode 600.
# Replace placeholders before starting. Keep single quotes around the bcrypt hash.
SITE_DOMAIN='REPLACE_WITH_DOMAIN'
ACME_EMAIL='REPLACE_WITH_EMAIL'
BASIC_AUTH_USER='nara'
BASIC_AUTH_HASH='REPLACE_WITH_CADDY_PASSWORD_HASH'
POSTGRES_PASSWORD='REPLACE_WITH_RANDOM_HEX'
INTERNAL_JOB_SECRET='REPLACE_WITH_DIFFERENT_RANDOM_HEX'
LINE_MODE='simulation'
LINE_CHANNEL_SECRET=''
LINE_CHANNEL_ACCESS_TOKEN=''
LLM_ENABLED='false'
LLM_PROVIDER='fake'
AWS_REGION='ap-southeast-1'
