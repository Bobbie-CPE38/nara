# Copy outside the repository to /etc/nara/nara.env, owned by root, mode 600.
# Replace placeholders before starting. Keep single quotes around the bcrypt hash.
SITE_DOMAIN='REPLACE_WITH_DOMAIN'
ACME_EMAIL='REPLACE_WITH_EMAIL'
BASIC_AUTH_USER='nara'
BASIC_AUTH_HASH='REPLACE_WITH_CADDY_PASSWORD_HASH'
# ASCII letters/digits only: this is interpolated into DATABASE_URL. Use openssl rand -hex 24.
POSTGRES_PASSWORD='REPLACE_WITH_RANDOM_HEX'
INTERNAL_JOB_SECRET='REPLACE_WITH_DIFFERENT_RANDOM_HEX'
# The AWS overlay pins APP_ENV=aws, AUTH_MODE=session and Secure cookies.
# Do not add AWS keys here. LINE/LLM remain explicit opt-ins.
LINE_MODE='simulation'
LINE_CHANNEL_SECRET=''
LINE_CHANNEL_ACCESS_TOKEN=''
LLM_ENABLED='false'
LLM_PROVIDER='fake'
AWS_REGION='ap-southeast-1'
# Bedrock through the Lambda proxy (round 6 PR B3, docs/deploy-aws.md). Set LLM_PROVIDER='lambda'
# and these two after creating the proxy; LLM_ENABLED='true' only after a test call works
LLM_LAMBDA_URL=''
LLM_LAMBDA_API_KEY=''
# Test accounts of a demo reset that log in without LINE (round 6 PR EV7, docs/workflow.md
# 6.37.9). Empty = none. 12 to 128 characters; anyone past the Basic Auth can try them.
# Nurses only; 'true' below also makes the head nurses and the Supervisor, who can open
# every ward and the Demo control. Turn it on for a test session only, then back to 'false'
DEMO_ACCOUNT_PASSWORD=''
DEMO_MANAGER_ACCOUNTS='false'
