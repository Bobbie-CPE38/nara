# Starts the NARA test stack when the machine boots (round 6 PR D,
# docs/deploy-aws.md). Install: copy to /etc/systemd/system/nara.service,
# then `sudo systemctl daemon-reload && sudo systemctl enable --now nara`.
#
# Every start reads Parameter Store again, so `sudo systemctl restart nara`
# picks up a changed secret.

[Unit]
Description=NARA test environment (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nara
# AWS_REGION and, if not the default, NARA_PARAMETER_PATH
EnvironmentFile=/etc/nara/aws.conf
ExecStartPre=/bin/bash /opt/nara/deploy/aws/load-env.sh
ExecStart=/usr/bin/docker compose --env-file /etc/nara/nara.env -f docker-compose.yml -f deploy/aws/docker-compose.aws.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/nara/nara.env -f docker-compose.yml -f deploy/aws/docker-compose.aws.yml down
# The first start installs the Python and npm packages
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
